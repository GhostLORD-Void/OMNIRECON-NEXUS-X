APP_NAME=OMNIRECON NEXUS X
APP_ENV=development
API_PREFIX=/v1
LOG_LEVEL=INFO
DATABASE_PATH=data/omnirecon.db
MODEL_TIMEOUT_SECONDS=60

# Hybrid fallback order: first configured provider is tried first.
PROVIDER_ORDER=openai,anthropic,google,local

# OpenAI API (optional)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic API (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini API (optional)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Local OpenAI-compatible runtime (optional: Ollama / LM Studio)
# Ollama example: http://127.0.0.1:11434/v1
LOCAL_MODEL_BASE_URL=
LOCAL_MODEL_API_KEY=local
LOCAL_MODEL_NAME=
